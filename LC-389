class Solution {
    public char findTheDifference(String s, String t) {
        int sum = 0;
        for(int i = 0 ; i < s.length();i++){
            sum = sum + s.charAt(i);
        }
        int sum2 = 0;
        for(int i = 0 ; i < t.length();i++){
            sum2  = sum2 + t.charAt(i);
        }
        int a = sum2 - sum;
        return (char)a;
    }
    }
