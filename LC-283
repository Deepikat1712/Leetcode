class Solution {
    public void moveZeroes(int[] nums) {
        int a[] = new int[nums.length];
        int b = 0;
        for(int i = 0; i<nums.length ; i++){
            if(nums[i] != 0){
                a[b]=nums[i];
                b++;
            }

        }
        for(int i = b; i<nums.length ; i++){
            a[i] = 0;
        }
        for(int i = 0 ; i < nums.length ; i++){
            nums[i] = a[i];
        }
    }
}
