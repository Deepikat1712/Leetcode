class Solution {
    public void rotate(int[] nums, int k) {
        int l = nums.length;
        int a[] = new int[l];
        k = k % l;
        for(int i = 0 ; i < l ; i++){
            a[(i+k)%l] = nums[i];
         }
         for(int i = 0 ; i < l ; i++){
            
            nums[i] = a[i];
         }
       
        
    }
}
