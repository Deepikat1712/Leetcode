class Solution {
    public void moveZeroes(int[] nums) {
        int n = nums.length;
        for(int i = 0 ; i < nums.length ; i++){
            for(int j = i+1 ; j < nums.length ; j++){
                if((nums[i] == 0)&&(nums[j] != 0)){
                    int t = nums[j];
                    nums[j] = nums[i];
                    nums[i] = t;
                }
            
            }
        }
      
    }
}
