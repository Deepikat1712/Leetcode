import java.util.Arrays;
class Solution {
    public int missingNumber(int[] nums) {
        int max=nums[0] ; 
        for(int i = 1 ; i < nums.length ; i++){
            if(max< nums[i]){
                max= nums[i];
            }
        }
         Arrays.sort(nums);
        for(int i = 0 ; i < max ; i++){
            if(i != nums[i] ){
                return i;
            }
        }
        return max+1;
    }
}
